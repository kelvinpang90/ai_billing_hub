# /etc/cron.d/ai_billing_hub —— 备份与 binlog 离机的定时任务（spec §98.1；T0.9）。
#
# 安装（在 VPS 的 /opt/ai_billing_hub 里，用部署用户执行）：
#
#     sed "s/@DEPLOY_USER@/$(id -un)/" deploy/cron.d/ai_billing_hub \
#         | sudo tee /etc/cron.d/ai_billing_hub >/dev/null
#     sudo chmod 0644 /etc/cron.d/ai_billing_hub
#
# ⚠️ 用 /etc/cron.d 而不是 `crontab <file>`：后者**整个替换**该用户的 crontab，
#    同一台机器上其它项目的定时任务会被一并抹掉。
# ⚠️ 用户名是占位符：真实的部署账号不进公开仓库。
# ⚠️ 日志进 syslog：`journalctl -t billing-binlog` / `-t billing-backup` / `-t billing-drill`
#    / `-t billing-monitor` / `-t billing-logs` / `-t billing-config`。
# ⚠️ 失败与破 RPO 以 err 级别单独进 syslog：`journalctl -t billing-binlog -p err`。
#    把它送到人手里是告警通道的事（§95），这个文件不负责。

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# binlog 离机，**每分钟**。
# ⚠️ 锁在脚本里，不在这一行：上一轮还没跑完时，本轮仍要先查一次「binlog 多久没离机」
#    再跳过。锁放在 cron 这一行的话，一次卡死的运行会让之后每一轮都在进脚本之前就被
#    挡掉，那种状态下永远不会有人报警（Codex #42 R2）。
# ⚠️ 每分钟而不是每 4 分钟：被跳过的代价是一分钟，而不是一整个周期。空闲时脚本不
#    FLUSH、不上传，所以每分钟一次不会造出一堆空文件。
* * * * * @DEPLOY_USER@ cd /opt/ai_billing_hub && bash deploy/binlog_ship.sh 2>&1 | logger -t billing-binlog

# 全量，每天一次，马来西亚 03:17（业务低谷）。避开整点，免得与其它项目撞车。
# ⚠️ cron 按**系统时区**解释，而生产 VPS 的系统时区是 **UTC+8**（2026-09-14 实测：
#    同一时刻 journalctl 显示 17:04、脚本的 `date -u` 打出 09:04）。第一版按「VPS 是 UTC」
#    写成 `17 19`，实际会在马来西亚晚上 19:17 跑。换主机时先 `timedatectl` 看时区再定这一行。
# ⚠️ 这个文件是**复制**进 /etc/cron.d 的，改完要按上面的安装命令重装一次才生效。
17 3 * * * @DEPLOY_USER@ cd /opt/ai_billing_hub && flock -n /tmp/ai_billing_hub-backup.lock bash deploy/backup.sh 2>&1 | logger -t billing-backup

# 日志外送，每天马来西亚 03:47：抓过去一天的容器日志 → 打包 → 加密 → 验证 → 传 R2 的 logs/ 前缀，
# 然后按保留期与总量上限清理本机归档（安全删除）。排在 03:17 的全量之后，两者不会抢同一个窗口。
# ⚠️ json-file 按大小轮转不按时间：某个服务一天写爆 30 MB 时，抓到的就是被截断的一段（脚本头部有说明）。
47 3 * * * @DEPLOY_USER@ cd /opt/ai_billing_hub && flock -n /tmp/ai_billing_hub-logs.lock bash deploy/log_ship.sh 2>&1 | logger -t billing-logs

# 部署配置快照，每天马来西亚 03:57（排在日志外送之后）：把「在新主机上重建这个栈还需要
# 知道什么」离机 —— 部署的 commit、.env 的**键名**、cron、nginx 配置校验和、在跑的镜像。
# ⚠️ 绝不含任何密钥的值；上传前脚本会拿 .env 里的真值自查一遍，撞上就拒传。
57 3 * * * @DEPLOY_USER@ cd /opt/ai_billing_hub && flock -n /tmp/ai_billing_hub-config.lock bash deploy/config_snapshot.sh 2>&1 | logger -t billing-config

# 生产巡检（容器健康 / `/readyz` 降级 / 磁盘水位），每 5 分钟。三条心跳分开发，
# 地址见 .env 的 BILLING_HEALTHCHECK_{SERVICES,READYZ,DISK}_URL（docs/deployment.md §8）。
# ⚠️ **不加 flock**：这个脚本是只读巡检，两轮重叠没有副作用；而 flock 会让一次卡死的
#    运行把之后每一轮都挡在脚本外面 —— 那种状态下反倒**没有任何**心跳异常可查
#    （与 binlog_ship.sh 同一条教训，Codex #42 R2）。真卡死时心跳自然停发，外部服务会发现。
*/5 * * * * @DEPLOY_USER@ cd /opt/ai_billing_hub && bash deploy/monitor.sh 2>&1 | logger -t billing-monitor

# 自动恢复演练，每周日马来西亚 04:47（Kelvin 2026-09-15 定每周一次）：排在当天 03:17 的全量之后，
# 那份全量的锚点 binlog 一分钟内就已离机。锁与失败通知都在脚本里（心跳 BILLING_HEALTHCHECK_DRILL_URL）。
47 4 * * 0 @DEPLOY_USER@ cd /opt/ai_billing_hub && bash deploy/restore_drill.sh 2>&1 | logger -t billing-drill

# 本地开发模板：复制成 .env 再改。
# ⚠️ 仓库是公开的 —— .env 已被 .gitignore 忽略，且绝不可提交任何真实凭据、
#    密钥、主机名或 IP。本文件只放占位值。
#
# 配置项全部带 BILLING_ 前缀，定义见 app/core/config.py。
# 新增配置项时同步加到这里，否则别人克隆下来跑不起来。

# local | production
BILLING_ENVIRONMENT=local

# 打开 FastAPI 的 debug 行为，仅限本地
BILLING_DEBUG=true

# CRITICAL | ERROR | WARNING | INFO | DEBUG
BILLING_LOG_LEVEL=INFO

# 数据库连接串。留空 = 未配置：应用照常启动、`/healthz` 照常应答，
# `/readyz` 明确报 DATABASE_NOT_CONFIGURED。
# ⚠️ 下面是**占位符**。真实主机名 / 用户名 / 密码绝不可提交（仓库是公开的）。
BILLING_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4

# Celery 的 broker。留空 = 未配置：API 照常起、`/readyz` 报 degraded；
# 但 worker 起不来（没有 broker 的 worker 没有存在意义）。
# ⚠️ Redis **不是**就绪阻断项，理由见 app/core/broker.py。
BILLING_REDIS_URL=redis://HOST:6379/0


# ---------------------------------------------------------------------------
# 只给 docker-compose.yml 用的变量
# ---------------------------------------------------------------------------
# 上面那两个 URL 是给「直接跑 uvicorn」用的（指向 127.0.0.1）。容器里的连接串
# 由 docker-compose.yml 用下面这几个变量拼出来，指向服务名 mysql / redis，
# **不读上面两行** —— compose 里刻意没有 env_file，理由写在那个文件的开头。

# ⚠️ 下面两个密码**故意留空**。留空时 `docker compose up` 会直接报错停住，
#    而不是悄悄起一个空密码的数据库。自己填一个本地一次性的值。
#    别在这里写真实密码然后不小心提交（仓库是公开的，`.env` 才是你该改的文件）。
# ⚠️ 密码里**不要出现 @ : / #**：它会被拼进 DSN，这几个字符会把解析切错位置，
#    症状是「密码明明对却连不上」。
BILLING_MYSQL_ROOT_PASSWORD=
BILLING_MYSQL_PASSWORD=

# 应用连库用的账号（不是 root），以及库名
BILLING_MYSQL_USER=billing
BILLING_MYSQL_DATABASE=billing

# nginx 在宿主机上监听的端口。整个栈只发布这一个端口：
# mysql / redis / api 都不对宿主机开放。
BILLING_HTTP_PORT=8080


# ---------------------------------------------------------------------------
# 认证（T0.8，设计闸门 Issue #32 v5）
# ---------------------------------------------------------------------------
# ⚠️ **访问令牌的签名密钥不在这里，也不在任何环境变量里。**
#    它走文件注入（ADR-0004 第 2 节）：环境变量会进 /proc/<pid>/environ、
#    崩溃转储，并被子进程继承。
#
#    起栈前先生成一次（文件已被 .gitignore 挡住）：
#        mkdir -p secrets && openssl rand -base64 48 > secrets/jwt.key
#
#    compose 把它挂成 /run/secrets/billing_jwt_key，并只把**路径**写进
#    BILLING_JWT_SECRET_FILE。文件不存在时 `docker compose up` 直接失败 ——
#    与密码留空同一种 fail-closed。
#
#    信封加密的主密钥同理，另外生成一把（格式是 `版本:base64`，轮换时加一行
#    更高版本的即可，老数据仍按自己的版本解开）：
#        echo "1:$(openssl rand -base64 32)" > secrets/master.key
#
#    ⚠️ **主密钥丢了，所有 TOTP 注册全部作废** —— 每个管理员都要重新扫码。
#
# 直接跑 uvicorn（不经 compose）时才需要在这里指路径：
# BILLING_JWT_SECRET_FILE=./secrets/jwt.key
# BILLING_MASTER_KEY_FILE=./secrets/master.key

# 两步登录中间那张 pending 令牌的寿命，两条路径刻意不同（设计闸门 #37）：
# 日常登录 120 秒够用；ADMIN 首次登录还要扫码 + 抄下 10 个恢复码，实测 120 秒不够。
# ⚠️ 两个值都必须为正数，设成 0 或负数时进程**直接起不来**（令牌会签发即过期，
#    表现为「全部新管理员登不进去」）。默认值够用，一般不需要在这里设。
# BILLING_PENDING_TOKEN_TTL_SECONDS=120
# BILLING_ENROLMENT_PENDING_TOKEN_TTL_SECONDS=600

# ⚠️ 默认 true。本地跑 http 时 Secure cookie 不会被发送，所以本地要显式关掉 ——
#    让不安全成为一次有意识的选择。compose 已经替本地栈设成 false。
# BILLING_SESSION_COOKIE_SECURE=false

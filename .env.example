# 本地开发模板：复制成 .env 再改。
# ⚠️ 仓库是公开的 —— .env 已被 .gitignore 忽略，且绝不可提交任何真实凭据、
#    密钥、主机名或 IP。本文件只放占位值。
#
# 配置项全部带 BILLING_ 前缀，定义见 app/core/config.py。
# 新增配置项时同步加到这里，否则别人克隆下来跑不起来。

# local | production
BILLING_ENVIRONMENT=local

# 打开 FastAPI 的 debug 行为，仅限本地
BILLING_DEBUG=true

# CRITICAL | ERROR | WARNING | INFO | DEBUG
BILLING_LOG_LEVEL=INFO

# 数据库连接串。留空 = 未配置：应用照常启动、`/healthz` 照常应答，
# `/readyz` 明确报 DATABASE_NOT_CONFIGURED。
# ⚠️ 下面是**占位符**。真实主机名 / 用户名 / 密码绝不可提交（仓库是公开的）。
BILLING_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4

# Celery 的 broker。留空 = 未配置：API 照常起、`/readyz` 报 degraded；
# 但 worker 起不来（没有 broker 的 worker 没有存在意义）。
# ⚠️ Redis **不是**就绪阻断项，理由见 app/core/broker.py。
BILLING_REDIS_URL=redis://HOST:6379/0

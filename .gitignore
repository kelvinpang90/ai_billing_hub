# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
# CI 的 backend job 把 pytest 输出落盘再检查有没有 skipped
pytest-output.txt

# Node
node_modules/
dist/
.vite/

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime
*.log
/data/
.codex-review-*.md
.codex-input-*.md
.codex-pr-body-*.md
.codex-response-*.md

# 本地生成的密钥文件，绝不提交（ADR-0004：密钥走文件注入，不进仓库）
/secrets/

# 备份产物（T0.9）。⚠️ 仓库是公开的，而这里面是**整个计费库**。
# 它是加密的，但「加密了所以可以提交」是错的推理：口令一旦泄漏，
# 历史里那份密文永远拿不回来 —— git 删不掉已经推出去的东西。
/backups/
# 恢复时从离机存储拉回来的备份（deploy/restore.sh 的工作目录）。与上面同一个道理。
/restore/
# 部署脚本记下的「上一个成功部署」（deploy/deploy.sh）。它是**主机上的状态**，
# 每台机器各不相同，进仓库只会互相覆盖。
/.last-good-deploy
/.last-good-deploy-history
/.last-good-deploy.tmp

# 日志归档（deploy/log_ship.sh 的产出）。同样是加密的，同样不进仓库 ——
# 里面是脱敏之后仍能拼出业务轮廓的东西（租户、路径、时间线）。
/logs/
